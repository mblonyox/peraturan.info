{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "name": "peraturan-info",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  "cache": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "data-peraturan",
      "database_id": "c665fed0-21e8-45f9-b3e0-35dbff130803",
      "migrations_dir": "../../migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "59217a617c694e75a3f3f019202c0652"
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "exports": {
    "DOQueueHandler": {
      "type": "durable-object",
      "state": "deleted"
    },
    "DOShardedTagCache": {
      "type": "durable-object",
      "state": "deleted"
    }
  }
}