{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peraturan-info",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-07",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true,
  },
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "peraturan-info",
    },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "data-peraturan",
      "database_id": "c665fed0-21e8-45f9-b3e0-35dbff130803",
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DOQueueHandler",
        "DOShardedTagCache"
      ],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "DOVisitCounter"
      ],
    },
    {
      "tag": "v3",
      "deleted_classes": [
        "DOVisitCounter"
      ]
    },
    {
      "tag": "v4",
      "deleted_classes": [
        "DOQueueHandler",
        "DOShardedTagCache"
      ]
    }
  ],
}