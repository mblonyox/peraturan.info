---
import { Icon } from "astro-iconset/components";

const { title, description, url } = Astro.props;
---

<a
  class="btn btn-block btn-secondary btn-sm md:btn-md lg:btn-lg text-neutral-content web-share-btn"
  data-description={description}
  data-title={title}
  data-url={url}
  href={`https://www.addtoany.com/share#url=${encodeURIComponent(url)}&title=${encodeURIComponent(title)}`}
  rel="noopener noreferrer"
  target="_blank"
>
  <Icon name="ri:share-line" />
  Bagikan
</a>

<script>
  document.querySelectorAll(".web-share-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      if ("share" in navigator) {
        e.preventDefault();
        const currentBtn = e.currentTarget as HTMLElement;
        navigator
          .share({
            title: currentBtn.dataset.title ?? "",
            text: currentBtn.dataset.description ?? "",
            url: currentBtn.dataset.url ?? "",
          })
          .catch(console.error);
      }
    });
  });
</script>
