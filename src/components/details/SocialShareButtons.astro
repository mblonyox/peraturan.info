---
interface Props {
  title: string;
  text?: string;
}

import { Icon } from "astro-iconset/components";

import { ellipsis } from "@/lib/utils/string";

import WebShareButton from "./WebShareButton.astro";

const { title, text } = Astro.props;

const url = Astro.url.href;
const tweetText = ellipsis(text ?? title, 240);
const waText = ellipsis(text ?? title, 240) + " " + url;
---

<div class="flex flex-col md:flex-row gap-1 my-2 lg:my-3">
  <div class="flex-1">
    <a
      href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(tweetText)}&url=${encodeURIComponent(url)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-block bg-[#15202b] text-neutral-content"
    >
      <Icon name="ri:twitter-x-line" />
      Tweet
    </a>
  </div>
  <div class="flex-1">
    <a
      href={`https://wa.me/?text=${encodeURIComponent(waText)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-block bg-[#25D366] text-neutral-content"
    >
      <Icon name="ri:whatsapp-line" />
      WhatsApp
    </a>
  </div>
  <div class="flex-1">
    <a
      href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-block bg-[#0e76a8] text-neutral-content"
    >
      <Icon name="ri:linkedin-box-line" />
      LinkedIn
    </a>
  </div>
  <div class="flex-1">
    <WebShareButton {...{ url, title, text }} />
  </div>
</div>
