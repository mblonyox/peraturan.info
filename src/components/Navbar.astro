---
import { Image } from "astro:assets";
import { Icon } from "astro-iconset/components";

import SearchInput from "@/components/SearchInput";
import ThemeSwitcher from "@/components/ThemeSwitcher";

const pathname = Astro.url.pathname;

const menus = [
  { href: "/", text: "Beranda" },
  { href: "/terbaru", text: "Terbaru" },
  {
    href: "#",
    text: "Peraturan",
    menu: [
      { href: "/uu", text: "Undang\u2011Undang" },
      { href: "/perppu", text: "Perppu" },
      { href: "/pp", text: "Peraturan\u00A0Pemerintah" },
      { href: "/perpres", text: "Peraturan\u00A0Presiden" },
      { href: "/permenkeu", text: "Peraturan\u00A0Menteri\u00A0Keuangan" },
    ],
  },
];
---

<nav class="navbar bg-base-200">
  <div class="navbar-start">
    <details class="flex-none lg:hidden dropdown">
      <summary aria-label="Show Menu" class="btn btn-square btn-ghost">
        <Icon name="ri:menu-line" />
      </summary>
      <ul
        class="menu dropdown-content bg-base-300 rounded-box z-1 p-2 shadow-2xl"
      >
        {
          menus.map(({ href, text, menu }) => (
            <li>
              {menu ? (
                <details open>
                  <summary>{text}</summary>
                  <ul>
                    {menu.map(({ href, text }) => (
                      <li>
                        <a
                          href={href}
                          class={pathname === href ? "menu-active" : ""}
                          aria-current={pathname === href ? "page" : "false"}
                        >
                          {text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a
                  href={href}
                  class={pathname === href ? "menu-active" : ""}
                  aria-current={pathname === href ? "page" : "false"}
                >
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </details>
    <a href="/" class="hidden lg:block">
      <Image src="/logo.webp" alt="Logo Peraturan.Info" width="32" height="32" loading="eager" />
    </a>
    <ul class="hidden lg:flex menu menu-horizontal rounded-box gap-2">
      {
        menus.map(({ href, text, menu }) => (
          <li>
            {menu ? (
              <div class="dropdown dropdown-start">
                <div tabindex="0" role="button">
                  <span class="mx-1">{text}</span>
                  <Icon name="ri:arrow-drop-down-line" class="inline-block" />
                </div>
                <ul
                  tabindex="-1"
                  class="menu dropdown-content bg-base-300 rounded-box z-1 p-2 shadow-2xl"
                >
                  {menu.map(({ href, text }) => (
                    <li>
                      <a
                        href={href}
                        class={pathname === href ? "menu-active" : ""}
                        aria-current={pathname === href ? "page" : "false"}
                      >
                        {text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <a
                href={href}
                class={pathname === href ? "menu-active" : ""}
                aria-current={pathname === href ? "page" : "false"}
              >
                {text}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
  <div class="navbar-center">
    <SearchInput client:load transition:persist />
  </div>
  <div class="navbar-end">
    <div class="hidden lg:block scheme-light mt-3 ml-3 xl:ml-[25%]" google-add-preferred-source-btn />
    <ThemeSwitcher client:load transition:persist />
  </div>
</nav>
