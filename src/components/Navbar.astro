---
import { Image } from "astro:assets";
import { Icon } from "astro-iconset/components";

import SearchInput from "@/components/SearchInput";
import ThemeSwitcher from "@/components/ThemeSwitcher";

const pathname = Astro.url.pathname;

const menus = [
  { href: "/", text: "Beranda" },
  { href: "/terbaru", text: "Terbaru" },
  {
    href: "#",
    text: "Peraturan",
    menu: [
      { href: "/uu", text: "Undang\u2011Undang" },
      { href: "/perppu", text: "Perppu" },
      { href: "/pp", text: "Peraturan\u00A0Pemerintah" },
      { href: "/perpres", text: "Peraturan\u00A0Presiden" },
      { href: "/permenkeu", text: "Peraturan\u00A0Menteri\u00A0Keuangan" },
    ],
  },
];
---

<nav class="navbar bg-base-200">
  <div class="navbar-start">
    <div class="flex-none lg:hidden dropdown">
      <button aria-label="Nav Menu" class="btn m-1" tabindex="0">
        <Icon name="ri:menu-line" />
      </button>
      <ul
        class="menu dropdown-content bg-base-300 rounded-box z-1 p-2 shadow-2xl"
        tabindex="-1"
      >
        {menus.map(({ href, text, menu }) => (
          <li>
            {menu ? (
              <details open>
                <summary>{text}</summary>
                <ul>
                  {menu.map(({ href, text }) => (
                    <li>
                      <a
                        aria-current={pathname === href ? "page" : "false"}
                        class:list={{ "menu-active": pathname === href }}
                        href={href}
                      >
                        {text}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a
                aria-current={pathname === href ? "page" : "false"}
                class:list={{ "menu-active": pathname === href }}
                href={href}
              >
                {text}
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
    <a class="hidden lg:block" href="/">
      <Image
        alt="Logo Peraturan.Info"
        height="48"
        loading="eager"
        src="/logo.webp"
        width="48"
      />
    </a>
    <ul class="hidden lg:flex menu menu-horizontal rounded-box gap-2">
      {menus.map(({ href, text, menu }) => (
        <li>
          {menu ? (
            <div class="dropdown dropdown-start">
              <button tabindex="0">
                <span class="mx-1">{text}</span>
                <Icon class="inline-block" name="ri:arrow-drop-down-line" />
              </button>
              <ul
                class="menu dropdown-content bg-base-300 rounded-box z-1 p-2 shadow-2xl"
                tabindex="-1"
              >
                {menu.map(({ href, text }) => (
                  <li>
                    <a
                      aria-current={pathname === href ? "page" : "false"}
                      class:list={{ "menu-active": pathname === href }}
                      href={href}
                    >
                      {text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <a
              aria-current={pathname === href ? "page" : "false"}
              class:list={{ "menu-active": pathname === href }}
              href={href}
            >
              {text}
            </a>
          )}
        </li>
      ))}
    </ul>
  </div>
  <div class="navbar-center">
    <SearchInput client:load transition:persist />
  </div>
  <div class="navbar-end">
    <div
      class="hidden lg:block scheme-light my-auto mx-auto"
      google-add-preferred-source-btn
    />
    <ThemeSwitcher client:load transition:persist />
  </div>
</nav>
