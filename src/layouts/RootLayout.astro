---
export type Props = SEOProps & { image?: string; imageAlt?: string };

import "@/styles/globals.css";

import { SEO, type SEOProps } from "astro-seo";

import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar.astro";

let {
  title,
  titleTemplate,
  titleDefault,
  description,
  extend,
  image,
  imageAlt,
  ...seoProps
} = Astro.props;

titleDefault ??= "Peraturan.Info";
titleTemplate ??= "%s | Peraturan.Info";
description ??=
  "Peraturan.Info adalah upaya untuk meningkatkan cara penyajian peraturan " +
  "perundang-undangan di Indonesia sehingga lebih user-friendly yang terinspirasi " +
  "dari legislation.gov.uk.";
image ??= new URL("/og-image.png", Astro.site).href;
imageAlt ??= "Peraturan.Info";
---

<html lang="id" class="h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      titleTemplate={titleTemplate}
      titleDefault={titleDefault}
      description={description}
      openGraph={{
        basic: {
          type: "website",
          title: title ?? titleDefault,
          url: new URL(Astro.url.pathname, Astro.site).href,
          image,
        },
        optional: {
          description,
          locale: "id_ID",
          siteName: "Peraturan.Info"
        }
      }}
      twitter={{
        card: "summary_large_image",
        site: "@mblonyox",
        title,
        description,
        image,
        imageAlt
      }}
      extend={{
        link: [
          {
            rel: "icon",
            href: "/favicon.ico",
          },
          {
            rel: "apple-touch-icon",
            href: "/icons/apple-touch-icon.png",
          },
          {
            rel: "manifest",
            type: "application/manifest+json",
            href: "/manifest.json",
          },
          {
            rel: "search",
            type: "application/opensearchdescription+xml",
            title: "Peraturan.Info Search",
            href: "/search.xml",
          },
          {
            rel: "alternate",
            type: "application/rss+xml",
            title: "Peraturan.Info RSS",
            href: "/rss.xml",
          },
          {
            rel: "alternate",
            type: "application/atom+xml",
            title: "Peraturan.Info ATOM",
            href: "/atom.xml",
          },
          {
            rel: "alternate",
            type: "application/json",
            title: "Peraturan.Info JSON",
            href: "/feed.json",
          },
          ...(extend?.link ?? []),
        ],
        meta: [...(extend?.meta ?? [])],
      }}
      {...seoProps}
    />
  </head>
  <body class="min-w-sm min-h-screen flex flex-col justify-between">
    <Navbar />
    <Breadcrumbs />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
