---
export type Props = SEOProps & {
  image?: string;
  imageAlt?: string;
  imageType?: string;
  imageWidth?: number;
  imageHeight?: number;
};

import "@/styles/globals.css";

import { ClientRouter } from "astro:transitions";
import { SEO, type SEOProps } from "astro-seo";
import { pwaAssetsHead } from "virtual:pwa-assets/head";
import { pwaInfo } from "virtual:pwa-info";

import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar.astro";
import PromptUpdate from "@/components/PromptUpdate.astro";

let {
  title,
  titleTemplate,
  titleDefault,
  description,
  extend,
  image,
  imageAlt,
  imageType,
  imageWidth,
  imageHeight,
  ...seoProps
} = Astro.props;

titleDefault ??= "Peraturan.Info";
titleTemplate ??= "%s | Peraturan.Info";
description ??=
  "Peraturan.Info adalah upaya untuk meningkatkan cara penyajian peraturan " +
  "perundang-undangan di Indonesia sehingga lebih user-friendly yang terinspirasi " +
  "dari legislation.gov.uk.";
image ??= new URL("/og-image.png", Astro.site).href;
imageAlt ??= "Peraturan.Info";
imageType ??= "image/png";
imageWidth ??= 1200;
imageHeight ??= 630;

const parsedTitle = title ? titleTemplate.replace("%s", title) : titleDefault;
---

<html class="h-full antialiased" lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <SEO
      description={description}
      openGraph={{
        basic: {
          type: "website",
          title: parsedTitle,
          url: new URL(Astro.url.pathname, Astro.site),
          image,
        },
        optional: {
          description,
          locale: "id_ID",
          siteName: "Peraturan.Info",
        },
        image: {
          url: image,
          alt: imageAlt,
          type: imageType,
          width: imageWidth,
          height: imageHeight,
        },
      }}
      title={title}
      titleDefault={titleDefault}
      titleTemplate={titleTemplate}
      twitter={{
        card: "summary_large_image",
        site: "@mblonyox",
        title: parsedTitle,
        description,
        image,
        imageAlt,
      }}
      {...seoProps}
      extend={{
        link: [
          {
            rel: "search",
            type: "application/opensearchdescription+xml",
            title: "Peraturan.Info Search",
            href: "/search.xml",
          },
          {
            rel: "alternate",
            type: "application/rss+xml",
            title: "Peraturan.Info RSS",
            href: "/rss.xml",
          },
          {
            rel: "alternate",
            type: "application/atom+xml",
            title: "Peraturan.Info ATOM",
            href: "/atom.xml",
          },
          {
            rel: "alternate",
            type: "application/json",
            title: "Peraturan.Info JSON",
            href: "/feed.json",
          },
          ...(extend?.link ?? []),
        ],
        meta: extend?.meta,
      }}
    />
    {pwaAssetsHead.themeColor && (
      <meta content={pwaAssetsHead.themeColor.content} name="theme-color" />
    )}
    {pwaAssetsHead.links.map((props) => (
      <link {...props} />
    ))}
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <ClientRouter />
    <script
      async
      is:inline
      src="https://news.google.com/swg/js/v1/publisher.js"
    />
  </head>
  <body class="min-h-screen flex flex-col justify-between">
    <Navbar />
    <Breadcrumbs />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <PromptUpdate />
  </body>
</html>
