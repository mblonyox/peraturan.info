---
interface Props {
  error: unknown;
}

import RootLayout from "@/layouts/RootLayout.astro";

const { error } = Astro.props;
const errorMessage = error instanceof Error ? error.message : "Tidak diketahui";
const errorCause =
  error instanceof Error
    ? error.cause
    : "Kesalahan tidak diketahui, silakan laporkan ke admin.";
---

<RootLayout>
  <article class="my-8 flex flex-col gap-2">
    <hgroup class="text-center">
      <h2 class="font-bold text-2xl">500</h2>
      <p class="text-lg break-all">Terjadi kesalahan: {errorMessage}</p>
    </hgroup>
    <div class="md:w-2/3 lg:w-1/2 xl:w-1/3 2xl:w-1/4 mx-auto">
      <div class="card bg-base-200">
        <div class="card-body">
          <samp>{errorCause}</samp>
        </div>
      </div>
    </div>
    <div class="w-full flex flex-row gap-2 justify-center">
      <a href="/" class="btn btn-outline-secondary"> Kembali ke beranda </a>
      <button
        type="button"
        onclick="location.reload()"
        class="btn btn-secondary"
      >
        Coba lagi
      </button>
    </div>
  </article>
</RootLayout>
