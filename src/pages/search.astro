---
import { z } from "zod";

import PageHeading from "@/components/PageHeading.astro";
import Pagination from "@/components/Pagination.astro";
import RootLayout from "@/layouts/RootLayout.astro";
import { createClient, type Peraturan } from "@/lib/typesense";
import { ellipsis } from "@/lib/utils/string";
import { $searchParams } from "@/lib/utils/validate";

Astro.cache.set({
  maxAge: 3600,
  swr: 86400,
  tags: ["search"]
});

const averageQueryLength = 16;

const searchParamsSchema = $searchParams.pipe(
  z.object({
    page: z.coerce.number<string>().int().positive().default(1),
    limit: z.coerce.number<string>().int().max(100).min(5).default(10),
    query: z.string().optional().default(""),
  }),
);

const res = searchParamsSchema.safeParse(Astro.url.searchParams);
if (!res.success) throw Error("Invalid search parameters");
const { page, limit, query } = res.data;
const offset = (page - 1) * limit;
const client = createClient();
const response = await client
  .collections<Peraturan>("peraturan")
  .documents()
  .search({
    q: query,
    offset,
    limit,
  });
const hits = response.hits;
if (!hits?.length) return Astro.rewrite("/404");
const total = response.found_docs;
const start = offset + 1;
const end = offset + hits.length;
const headingProps = {
  title: `Hasil Pencarian: "${ellipsis(query, averageQueryLength)}"`,
  description: hits.length
    ? `Pencarian dengan kata kunci "${query}" menampilkan urutan ${
        start === end ? start : start + " s.d. " + end
      } dari ${total} hasil dalam ${response.search_time_ms}.`
    : "Pencarian tidak menemukan hasil.",
};
const layoutProps = {
  title: `Laman #${page} | ${headingProps.title}`,
  description: `Tampilan ${headingProps.title} ${headingProps.description}`,
};
const paginationProps = { total, page, pageSize: limit };
---

<RootLayout {...layoutProps}>
  <PageHeading {...headingProps} />
  <div class="container">
    <div class="grid grid-cols-2 xl:grid-cols-3 gap-2">
      {
        hits.map((hit) => (
          <div class="card card-border shadow-sm">
            <div class="card-body">
              <p class="card-title line-clamp-3 text-xl font-bold">
                {hit.document.judul}
              </p>
              <p class="font-light">
                {hit.document.jenis} {hit.document.nomor}
              </p>
              <div class="card-actions justify-end">
                <a href={hit.document.path} class="btn btn-outline">
                  Buka
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
    <Pagination {...paginationProps} />
  </div>
</RootLayout>
