---
import { Image } from "astro:assets";
import { Icon } from "astro-iconset/components";

import RootLayout from "@/layouts/RootLayout.astro";
import { getTopVisitedPaths } from "@/lib/analytics";
import { DAY } from "@/lib/constants";
import { getFeedListPeraturan, getPeraturan } from "@/lib/db";

Astro.cache.set({
  maxAge: DAY,
  tags: ["home"]
})

function formatTanggal(date: Date) {
  return date.toLocaleDateString("ID-id", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}

const feedList = await getFeedListPeraturan(10);
const terbaru = feedList.map((p) => ({
  tanggal: formatTanggal(p.tanggal_diundangkan),
  path: p?.path,
  nomor: p?.rujukPendek,
  judul: p?.judul,
}));
const results = await getTopVisitedPaths();
const terpopuler = await Promise.all(
  Object.entries(results)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 5)
    .map(async ([path, count]) => {
    const [jenis, tahun, nomor] = path.split("/");
    const peraturan = await getPeraturan({ jenis, tahun, nomor });
    return {
      path: peraturan?.path ?? "/",
      nomor: peraturan?.rujukPendek ?? "Tidak ada nomor",
      judul: peraturan?.judul ?? "Tidak ada judul",
      count,
    };
  }),
);

const seed = new Date().toISOString().slice(0, 10);
const buffer = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(seed));
const hashedSeed = Array.from(new Uint8Array(buffer).slice(0, 8), (b) => b.toString(16).padStart(2, "0")).join("");
const imgUrl = `https://picsum.photos/seed/${hashedSeed}/800?blur=5`;
---

<RootLayout>
  <div class="hero bg-base-300" style={`background-image: url(${imgUrl});`}>
    <div class="hero-overlay"></div>
    <div class="hero-content text-center">
      <div class="max-w-md">
        <Image
          src="/logo.webp"
          alt="Logo Peraturan.Info"
          class="mx-auto mb-5"
          width={256}
          height={256}
          loading="eager"
        />
        <h1 class="text-5xl font-bold mb-2">
          Peraturan<span class="text-neutral-500">.Info</span>
        </h1>
        <p class="mb-5">
          Peraturan.Info adalah upaya untuk meningkatkan cara penyajian
          peraturan perundang-undangan di Indonesia sehingga lebih user-friendly
          yang terinspirasi dari layanan{" "}
          <a
            href="https://legislation.gov.uk"
            target="_blank"
            rel="noreferrer noopener"
          >
            legislation.gov.uk
          </a>
          .
        </p>
        <a href="/all" class="btn btn-primary"> Lihat Semua Peraturan. </a>
      </div>
    </div>
  </div>
  <div class="container flex flex-col lg:flex-row my-5">
    <ul class="list justify-between rounded-box bg-base-200 flex-1">
      <li class="p-4 pb-2 text-xl font-bold">Terbaru</li>
      {
        terbaru.slice(0, 5).map(({ path, nomor, judul, tanggal }) => (
          <li class="list-row">
            <div class="flex flex-col items-center justify-center card p-4 bg-base-300 font-thin opacity-50">
              <span class="text-xs">{tanggal.split(" ")[1].slice(0, 3)}</span>
              <span class="text-4xl">{tanggal.split(" ")[0]}</span>
              <span class="text-sm border-t border-dashed">{tanggal.split(" ")[2]}</span>
            </div>
            <Image
              class="h-auto rounded-xs"
              src={new URL(path + "/thumbnail.png", Astro.site).href}
              alt={judul}
              width={64}
              height={64}
              loading="lazy"
            />
            <div class="list-col-grow">
              <div class="text-xs">{tanggal}</div>
              <a href={path} class="font-semibold link"><Icon name="ri:link" class="inline" /> {nomor}</a>
              <p class="text-sm">{judul}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <div class="divider lg:divider-horizontal"></div>
    <ul class="list justify-between rounded-box bg-base-200 flex-1">
      <li class="p-4 pb-2 text-xl font-bold">Terpopuler</li>
      {
        terpopuler.slice(0, 5).map(({ path, nomor, judul, count }, index) => (
          <li class="list-row">
            <div class="text-4xl font-thin opacity-50 tabular-nums">
              #{index + 1}
            </div>
            <Image
              class="h-auto rounded-xs"
              src={new URL(path + "/thumbnail.png", Astro.site).href}
              alt={judul}
              width={64}
              height={64}
              loading="lazy"
            />
            <div class="list-col-grow">
              <div class="text-xs">{count} kali dilihat</div>
              <a href={path} class="font-semibold link"><Icon name="ri:link" class="inline" /> {nomor}</a>
              <p class="text-sm">{judul}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</RootLayout>
