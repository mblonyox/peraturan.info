---
import { Icon } from "astro-iconset/components";

import PageHeading from "@/components/PageHeading.astro";
import RootLayout from "@/layouts/RootLayout.astro";
import { DAY, WEEK } from "@/lib/constants";
import { getListPeraturanByTanggal, getTanggalTerakhir } from "@/lib/db";

Astro.cache.set({
  maxAge: DAY,
  swr: WEEK,
  tags: ["terbaru"],
});

const searchParams = Astro.url.searchParams;
let tanggalParam = searchParams.get("tanggal");
if (tanggalParam) {
  if (
    !/^\d{4}-\d{2}-\d{2}$/.test(tanggalParam) ||
    isNaN(Date.parse(tanggalParam))
  ) {
    throw new Error("Tanggal tidak valid.");
  }
}
const tanggalTerakhir = await getTanggalTerakhir();
const tanggalDipilih = tanggalParam ?? tanggalTerakhir.at(0)?.tanggal;
if (!tanggalDipilih) throw new Error("Tidak ada data.");
const listPeraturan = await getListPeraturanByTanggal(tanggalDipilih);
if (!tanggalTerakhir.map(({ tanggal }) => tanggal).includes(tanggalDipilih)) {
  tanggalTerakhir.push({
    tanggal: tanggalDipilih,
    jumlah: listPeraturan.length,
  });
  tanggalTerakhir.sort((a, b) => (a.tanggal < b.tanggal ? 1 : -1));
}

const tanggalDipilihFmtd = new Date(tanggalDipilih).toLocaleDateString(
  "id-ID",
  {
    day: "numeric",
    month: "long",
    year: "numeric",
  },
);

const layoutProps = {
  title: `Peraturan Terbaru - ${tanggalDipilihFmtd}`,
  description: `Tampilan ${listPeraturan.length} peraturan terbaru yang diundangkan pada tanggal ${tanggalDipilihFmtd}`,
};
---

<RootLayout {...layoutProps}>
  <PageHeading
    description={
      <>
        Selalu <i>up-to-date</i> dengan Peraturan Perundang-undangan terbaru
        yang ditetapkan pada situs ini dengan layanan berlangganan gratis
        menggunakan <i>RSS Feed.</i>
      </>
    }
    title="Peraturan Terbaru"
  />
  <div class="container my-5">
    <div class="join join-vertical md:join-horizontal w-full my-2">
      <a class="join-item btn link flex-1 p-2" href="/atom.xml">
        <Icon name="bi:rss-fill" />
        Atom
      </a>
      <a class="join-item btn link flex-1 p-2" href="/rss.xml">
        <Icon name="bi:rss" />
        RSS 2.0
      </a>
      <a class="join-item btn link flex-1 p-2" href="/feed.json">
        <Icon name="bi:filetype-json" />
        JSON Feed
      </a>
    </div>
    <div class="card card-border">
      <div
        class="tabs tabs-border bg-base-200 rounded-box rounded-b-none"
        role="tablist"
      >
        {tanggalTerakhir.map(({ tanggal, jumlah }) => (
          <a
            aria-selected={tanggal === tanggalDipilih}
            class:list={[
              "tab flex-1 z-1 text-nowrap",
              tanggal === tanggalDipilih ? "tab-active" : "tab-inactive",
            ]}
            href={`/terbaru?tanggal=${tanggal}`}
            role="tab"
          >
            {new Date(tanggal).toLocaleDateString("id-ID", {
              day: "2-digit",
              month: "short",
            })}{" "}
            ({jumlah})
          </a>
        ))}
      </div>
      <div class="card-body p-0">
        {!listPeraturan.length ? (
          <div class="alert alert-info" role="alert">
            Tidak ada peraturan pada tanggal yang ditentukan.
          </div>
        ) : (
          <div class="flex-1 overflow-x-auto">
            <table class="table table-zebra">
              <thead>
                <tr>
                  <th scope="col">#</th>
                  <th scope="col">Judul</th>
                  <th scope="col">Nomor dan Tahun</th>
                  <th scope="col">Bentuk</th>
                </tr>
              </thead>
              <tbody>
                {listPeraturan.map(
                  ({ path, judul, nomorPendek, namaJenisPanjang }, index) => (
                    <tr>
                      <th scope="row">{index + 1}</th>
                      <td>{judul}</td>
                      <td>
                        <a class="link" href={path}>
                          {nomorPendek}
                        </a>
                      </td>
                      <td>{namaJenisPanjang}</td>
                    </tr>
                  ),
                )}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  </div>
</RootLayout>
