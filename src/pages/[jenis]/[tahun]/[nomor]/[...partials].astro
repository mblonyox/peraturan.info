---
import type { Params } from "astro";
import sanitize from "sanitize-html"

import PartialLayout from "@/layouts/PartialLayout.astro";
import { getPeraturan } from "@/lib/db";
import { createMarked, type PeraturanToken, sanitizeOptions } from "@/lib/marked";
import { getData } from "@/lib/utils/data";
import { handlerPartials } from "@/lib/utils/partials";

interface RouteParams extends Params {
  jenis: string;
  tahun: string;
  nomor: string;
  partials: string;
}

const { jenis, tahun, nomor, partials } = Astro.params as RouteParams;
const peraturan = await getPeraturan({ jenis, tahun, nomor });
if (!peraturan) return Astro.rewrite("/404");
const path = `${jenis}/${tahun}/${nomor}/fulltext.md`;
const md = await getData(path, { format: "text" });
if (!md) return Astro.rewrite("/404");
const marked = createMarked();
const rootTokens = marked.lexer(md) as PeraturanToken[];
const data = handlerPartials(partials, rootTokens)
if (!data) return Astro.rewrite("/404");
const { tokens, prev, next, title, description } = data;
const html = marked.parser(tokens);
const sanitizedHtml = sanitize(html, sanitizeOptions)

const image = new URL(`${peraturan.path}/${partials}/og-image.png`, Astro.site).href;
const imageAlt = `${partials}-${peraturan.rujukPendek}`;

Astro.cache.set({
  maxAge: 86400,
  swr: 2592000,
  tags: ["peraturan", `${jenis}/${tahun}/${nomor}`],
});

---

<PartialLayout {...{ peraturan, title, description, rootTokens, prev, next, image, imageAlt }}>
  <div set:html={sanitizedHtml} />
</PartialLayout>
