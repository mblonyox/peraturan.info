---
import RootLayout from "@/layouts/RootLayout.astro";
---

<RootLayout>
  <article class="my-8 flex flex-col gap-2">
    <hgroup class="text-center">
      <h2 class="font-bold text-2xl">404</h2>
      <p class="text-lg">Laman tidak ditemukan!</p>
    </hgroup>
    <div class="md:w-2/3 lg:w-1/2 xl:w-1/3 2xl:w-1/4 mx-auto">
      <div class="card bg-base-200">
        <div class="card-body">
          Laman yang Anda cari tidak ada atau sudah dihapus.
        </div>
      </div>
    </div>
    <div class="w-full text-center">
      <a href="/" class="btn btn-outline-secondary mx-auto">
        Kembali ke beranda
      </a>
    </div>
  </article>
</RootLayout>
